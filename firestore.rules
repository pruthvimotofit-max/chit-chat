rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isBlocked(userId, otherUserId) {
      return exists(
        /databases/$(database)/documents/users/$(userId)/blocked/$(otherUserId)
      );
    }

    // =========================
    // STORY ACCESS HELPERS
    // =========================

    function canViewStory(story) {
      return request.auth != null
        && (
          story.authorId == request.auth.uid
          || (
            story.expiresAt > request.time
            && story.visibility == "public"
          )
          || (
            story.expiresAt > request.time
            && story.visibility == "followers"
            && exists(
              /databases/$(database)/documents/users/$(story.authorId)/followers/$(request.auth.uid)
            )
          )
        );
    }

    // =========================
    // USER PROFILES
    // =========================

    match /users/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "username",
          "displayName",
          "photoURL",
          "bio",
          "website",
          "isPrivate",
          "isVerified",
          "followersCount",
          "followingCount",
          "postsCount",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.isVerified == false
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.postsCount == 0;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "photoURL",
          "bio",
          "website",
          "isPrivate",
          "updatedAt"
        ]);
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // =========================
    // FOLLOWERS
    // =========================

    match /users/{userId}/followers/{followerId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == followerId
        && followerId != userId
        && request.resource.data.keys().hasOnly([
          "followerId",
          "followingId",
          "createdAt"
        ])
        && request.resource.data.followerId == followerId
        && request.resource.data.followingId == userId;

      allow delete: if request.auth != null
        && request.auth.uid == followerId;

      allow update: if false;
    }

    // =========================
    // FOLLOWING
    // =========================

    match /users/{userId}/following/{followingId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && followingId != userId
        && request.resource.data.keys().hasOnly([
          "followerId",
          "followingId",
          "createdAt"
        ])
        && request.resource.data.followerId == userId
        && request.resource.data.followingId == followingId;

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      allow update: if false;
    }

    // =========================
    // BLOCKED USERS
    // =========================

    match /users/{userId}/blocked/{blockedUserId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && blockedUserId != userId
        && request.resource.data.keys().hasOnly([
          "userId",
          "blockedUserId",
          "createdAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.blockedUserId == blockedUserId;

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      allow update: if false;
    }

    // =========================
    // REPORTS
    // =========================

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "reporterId",
          "reportedUserId",
          "conversationId",
          "messageId",
          "reason",
          "status",
          "createdAt"
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.conversationId is string
        && request.resource.data.messageId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // =========================
    // USERNAMES
    // =========================

    match /usernames/{username} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // =========================
    // POSTS
    // =========================

    match /posts/{postId} {
      // Posts can be read by authenticated users.
      allow read: if request.auth != null;

      // A user can create a post only for themselves.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "authorId",
          "caption",
          "media",
          "mediaType",
          "postType",
          "visibility",
          "location",
          "taggedUserIds",
          "altText",
          "commentsEnabled",
          "hideLikeCount",
          "hideShareCount",
          "collaboratorIds",
          "isPinned",
          "pinnedAt",
          "likesCount",
          "commentsCount",
          "sharesCount",
          "repostsCount",
          "viewsCount",
          "isArchived",
          "archivedAt",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.postType in ["post", "reel"]
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.sharesCount == 0
        && request.resource.data.repostsCount == 0
        && request.resource.data.viewsCount == 0;

      // The author can update normal post fields.
      // A viewer can atomically increment viewsCount only when
      // creating their own unique view document in the same transaction.
      allow update: if (
        request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "caption",
          "media",
          "mediaType",
          "postType",
          "visibility",
          "location",
          "taggedUserIds",
          "altText",
          "commentsEnabled",
          "hideLikeCount",
          "hideShareCount",
          "collaboratorIds",
          "updatedAt"
        ])
        && request.resource.data.get("commentsEnabled", true) is bool
        && request.resource.data.get("hideLikeCount", false) is bool
        && request.resource.data.get("hideShareCount", false) is bool
        && request.resource.data.get("taggedUserIds", []) is list
        && request.resource.data.get("collaboratorIds", []) is list
        && request.resource.data.get("altText", "") is string
        && request.resource.data.get("altText", "").size() <= 1000
      ) || (
        request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isPinned",
          "pinnedAt",
          "updatedAt"
        ])
        && request.resource.data.isPinned is bool
        && (
          (
            request.resource.data.isPinned == true
            && request.resource.data.pinnedAt is timestamp
          )
          ||
          (
            request.resource.data.isPinned == false
            && request.resource.data.pinnedAt == null
          )
        )
      ) || (
        request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isArchived",
          "archivedAt",
          "updatedAt"
        ])
        && request.resource.data.isArchived is bool
        && (
          (
            request.resource.data.isArchived == true
            && request.resource.data.archivedAt is timestamp
          )
          ||
          (
            request.resource.data.isArchived == false
            && request.resource.data.archivedAt == null
          )
        )
      ) || (
        request.auth != null
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "viewsCount"
        ])
        && request.resource.data.viewsCount == resource.data.viewsCount + 1
        && getAfter(
          /databases/$(database)/documents/posts/$(postId)/views/$(request.auth.uid)
        ).data.userId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/posts/$(postId)/views/$(request.auth.uid)
        ).data.postId == postId
      );

      // Only the author can pin or unpin their post.
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isPinned",
          "pinnedAt",
          "updatedAt"
        ])
        && request.resource.data.isPinned is bool
        && (
          (
            request.resource.data.isPinned == true
            && request.resource.data.pinnedAt is timestamp
          )
          ||
          (
            request.resource.data.isPinned == false
            && request.resource.data.pinnedAt == null
          )
        );

      // Only the author can delete their post.
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // =========================
    // POST LIKES
    match /posts/{postId}/likes/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.keys().hasOnly([
          "userId",
          "postId",
          "createdAt"
        ]);

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.keys().hasOnly([
          "userId",
          "postId",
          "createdAt"
        ]);
    }

    // POST COMMENTS
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.keys().hasOnly([
          "userId",
          "postId",
          "text",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "text",
          "updatedAt"
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // COMMENT LIKES
    match /posts/{postId}/comments/{commentId}/likes/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.commentId == commentId
        && request.resource.data.keys().hasOnly([
          "userId",
          "postId",
          "commentId",
          "createdAt"
        ]);

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      allow update: if false;
    }

    // COMMENT REPLIES
    match /posts/{postId}/comments/{commentId}/replies/{replyId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.commentId == commentId
        && request.resource.data.keys().hasOnly([
          "userId",
          "postId",
          "commentId",
          "text",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.commentId == resource.data.commentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "text",
          "updatedAt"
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // POST SAVES
    match /posts/{postId}/saves/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.keys().hasOnly([
          "userId",
          "postId",
          "createdAt"
        ]);

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      allow update: if false;
    }

    // POST SHARES
    match /posts/{postId}/shares/{shareId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.keys().hasOnly([
          "postId",
          "userId",
          "method",
          "createdAt"
        ])
        && request.resource.data.method in [
          "native",
          "copy_link",
          "direct_message",
          "whatsapp",
          "facebook",
          "telegram",
          "x",
          "email"
        ];

      allow update: if false;
      allow delete: if false;
    }
    // =========================
    // POST REPOSTS
    // =========================
    match /reposts/{repostId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.originalAuthorId is string
        && request.resource.data.originalAuthorId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          "postId",
          "userId",
          "originalAuthorId",
          "createdAt"
        ])
        && repostId == request.auth.uid + "_" + request.resource.data.postId
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }



    // POST VIEWS
    match /posts/{postId}/views/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.keys().hasOnly([
          "postId",
          "userId",
          "createdAt"
        ]);

      allow update, delete: if false;
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /users/{userId}/notifications/{notificationId} {
      // Only the notification recipient can read their notifications.
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // A signed-in user can create a notification as themselves,
      // but cannot create one for themselves.
      allow create: if request.auth != null
        && request.resource.data.recipientId == userId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorId != userId
        && request.resource.data.keys().hasOnly([
          "recipientId",
          "actorId",
          "type",
          "message",
          "postId",
          "commentId",
          "conversationId",
          "storyId",
          "actorUsername",
          "actorPhotoURL",
          "isRead",
          "createdAt"
        ])
        && request.resource.data.isRead == false;

      // Only the recipient can mark their notifications as read/unread.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isRead"
        ])
        && request.resource.data.isRead is bool;

      // Recipients can delete their own notifications.
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // =========================
    // MESSAGES / CONVERSATIONS
    // =========================

    match /conversations/{conversationId} {

      // Participants can read existing conversations.
      // Authenticated users may also check a missing conversation document
      // because getOrCreateConversation() uses the deterministic
      // participantsKey document id before creating a conversation.
      allow get: if request.auth != null
        && (
          !exists(
            /databases/$(database)/documents/conversations/$(conversationId)
          )
          || request.auth.uid in resource.data.participantIds
        );

      allow list: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      // A conversation must contain exactly two different users,
      // and the authenticated user must be one of them.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "participantIds",
          "participantsKey",
          "lastMessage",
          "lastMessageAt",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.resource.data.lastMessage is string;

      // Participants can update conversation activity fields.
      // Plain activity updates cannot modify unread state.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantsKey == resource.data.participantsKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage",
          "lastMessageAt",
          "updatedAt"
        ])
        && request.resource.data.lastMessage is string;

      // Sending a message must atomically create that message and
      // update the conversation activity + recipient unread count.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantsKey == resource.data.participantsKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage",
          "lastMessageAt",
          "updatedAt",
          "lastMessageId",
          "unreadCounts"
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastMessageId.size() > 0
        && request.resource.data.get("unreadCounts", {}).get(
          request.auth.uid == resource.data.participantIds[0]
            ? resource.data.participantIds[1]
            : resource.data.participantIds[0],
          0
        ) is int
        && request.resource.data.get("unreadCounts", {}).get(
          request.auth.uid == resource.data.participantIds[0]
            ? resource.data.participantIds[1]
            : resource.data.participantIds[0],
          0
        )
        ==
        resource.data.get("unreadCounts", {}).get(
          request.auth.uid == resource.data.participantIds[0]
            ? resource.data.participantIds[1]
            : resource.data.participantIds[0],
          0
        ) + 1
        && getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
        ).data.senderId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
        ).data.messageType in [
          "text",
          "image",
          "video",
          "audio",
          "file"
        ];

      // Marking a conversation read may only clear the caller's
      // own unread count, and must atomically write that user's read state.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantsKey == resource.data.participantsKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "unreadCounts"
        ])
        && request.resource.data.get("unreadCounts", {}).get(
          request.auth.uid,
          0
        ) == 0
        && getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)/readState/$(request.auth.uid)
        ).data.userId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)/readState/$(request.auth.uid)
        ).data.lastReadAt == request.time;

      // A participant can hide a conversation only for themselves.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFor"])
        && request.resource.data.get("hiddenFor", []) is list
        && request.resource.data.get("hiddenFor", []).size() <= 2
        && request.resource.data.get("hiddenFor", []).hasOnly(resource.data.participantIds)
        && ((request.auth.uid in request.resource.data.get("hiddenFor", []))
          != (request.auth.uid in resource.data.get("hiddenFor", [])))
        && (
          (request.auth.uid == resource.data.participantIds[0]
            && ((resource.data.participantIds[1] in request.resource.data.get("hiddenFor", []))
              == (resource.data.participantIds[1] in resource.data.get("hiddenFor", [])))
          || (request.auth.uid == resource.data.participantIds[1]
            && ((resource.data.participantIds[0] in request.resource.data.get("hiddenFor", []))
              == (resource.data.participantIds[0] in resource.data.get("hiddenFor", [])))
        );

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participantIds;


      // =========================
      // CONVERSATION MESSAGES
      // =========================

      match /messages/{messageId} {

        // Only conversation participants can read messages.
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;

    // Only a conversation participant can send a message,
    // and the sender must be the authenticated user.
    allow create: if request.auth != null
      && request.auth.uid in get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data.participantIds
      && request.resource.data.senderId == request.auth.uid
      && !isBlocked(
        request.auth.uid,
        request.resource.data.senderId
      )
      && !(
        isBlocked(
          request.auth.uid,
          get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds[0] == request.auth.uid
            ? get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participantIds[1]
            : get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participantIds[0]
        )
      )
      && request.resource.data.keys().hasOnly([
        "senderId",
        "text",
        "messageType",
        "createdAt",
        "updatedAt",
        "isDeleted",
        "storyId",
        "attachmentUrl",
        "attachmentName",
        "attachmentType",
        "attachmentSize",
        "sharedContent"
      ])
      && request.resource.data.text is string
      && request.resource.data.text.size() <= 5000
      && request.resource.data.messageType in [
        "text",
        "image",
        "video",
        "audio",
        "file"
      ]
      && request.resource.data.isDeleted == false
      && (
        !request.resource.data.keys().hasAny(["storyId"])
        || (
          request.resource.data.storyId is string
          && request.resource.data.storyId.size() > 0
        )
      )
      && (
        !request.resource.data.keys().hasAny(["sharedContent"])
        || (
          request.resource.data.sharedContent is map
          && request.resource.data.sharedContent.keys().hasOnly([
            "type",
        "id",
        "url",
        "mediaUrl",
        "mediaType",
        "authorId",
        "caption",
        "latitude",
        "longitude"
      ])
          && request.resource.data.sharedContent.type is string
          && request.resource.data.sharedContent.type in [
     "post",
     "reel",
     "location"
   ]
          && request.resource.data.sharedContent.id is string
          && request.resource.data.sharedContent.id.size() > 0
   && (
     request.resource.data.sharedContent.type != "location"
     || (
       request.resource.data.sharedContent.latitude is number
       && request.resource.data.sharedContent.longitude is number
       && request.resource.data.sharedContent.latitude >= -90
       && request.resource.data.sharedContent.latitude <= 90
       && request.resource.data.sharedContent.longitude >= -180
       && request.resource.data.sharedContent.longitude <= 180
     )
   )
          && (
            !request.resource.data.sharedContent.keys().hasAny(["url"])
            || request.resource.data.sharedContent.url is string
          )
          && (
            !request.resource.data.sharedContent.keys().hasAny(["mediaUrl"])
            || request.resource.data.sharedContent.mediaUrl is string
          )
          && (
            !request.resource.data.sharedContent.keys().hasAny(["mediaType"])
            || request.resource.data.sharedContent.mediaType is string
          )
          && (
            !request.resource.data.sharedContent.keys().hasAny(["authorId"])
            || request.resource.data.sharedContent.authorId is string
          )
          && (
            !request.resource.data.sharedContent.keys().hasAny(["caption"])
            || request.resource.data.sharedContent.caption is string
          )
        )
      )
      && (
        request.resource.data.messageType == "text"
        ? !request.resource.data.keys().hasAny([
            "attachmentUrl",
            "attachmentName",
            "attachmentType",
            "attachmentSize"
          ])
        : request.resource.data.keys().hasAll([
            "attachmentUrl",
            "attachmentName",
            "attachmentType",
            "attachmentSize"
          ])
          && request.resource.data.attachmentUrl is string
          && request.resource.data.attachmentUrl.size() > 0
          && request.resource.data.attachmentName is string
          && request.resource.data.attachmentName.size() > 0
          && request.resource.data.attachmentName.size() <= 255
          && request.resource.data.attachmentType is string
          && request.resource.data.attachmentType.size() > 0
          && request.resource.data.attachmentType.size() <= 200
          && request.resource.data.attachmentSize is int
          && request.resource.data.attachmentSize > 0
          && request.resource.data.attachmentSize <= 25 * 1024 * 1024
      );

        // Messages cannot have their content edited.
        // Users may only add, change, or remove their own reaction.
        allow update: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "reactions",
            "updatedAt"
          ])
          && request.resource.data.reactions is map
          && (
            !resource.data.keys().hasAny(["reactions"])
            || request.resource.data.reactions.diff(
              resource.data.reactions
            ).affectedKeys().hasOnly([
              request.auth.uid
            ])
          )
          && (
            !request.resource.data.reactions.keys().hasAny([
              request.auth.uid
            ])
            || (
              request.resource.data.reactions[request.auth.uid] is string
              && request.resource.data.reactions[request.auth.uid].size() > 0
              && request.resource.data.reactions[request.auth.uid].size() <= 8
            )
          );

        // A sender can hide their own message only for themselves.
        // The deletedFor set may only gain the authenticated sender's UID.
        allow update: if request.auth != null
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "deletedFor",
            "updatedAt"
          ])
          && request.resource.data.deletedFor is list
          && (
            resource.data.keys().hasAny(["deletedFor"])
              ? request.resource.data.deletedFor.toSet()
                == resource.data.deletedFor.toSet().union(
                  [request.auth.uid].toSet()
                )
              : request.resource.data.deletedFor.toSet()
                == [request.auth.uid].toSet()
          );

        // A sender can unsend their own message for everyone.
        // This preserves the message document while removing its content.
        allow update: if request.auth != null
          && resource.data.senderId == request.auth.uid
          && (
            !resource.data.keys().hasAny(["isDeleted"])
            || resource.data.isDeleted == false
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "isDeleted",
            "text",
            "messageType",
            "updatedAt",
            "attachmentUrl",
            "attachmentName",
            "attachmentType",
            "attachmentSize",
            "sharedContent",
            "storyId",
            "reactions"
          ])
          && request.resource.data.isDeleted == true
          && request.resource.data.text == ""
          && request.resource.data.messageType == "text"
          && !request.resource.data.keys().hasAny([
            "attachmentUrl",
            "attachmentName",
            "attachmentType",
            "attachmentSize",
            "sharedContent",
            "storyId",
            "reactions"
          ]);

        // A sender can delete their own message document only through
        // legacy/direct deletion paths that are explicitly permitted.
        allow delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }


      // =========================
      // MESSAGE READ STATE
      // =========================

      match /readState/{userId} {

        // Conversation participants can read read-state documents
        // so the sender can determine whether their message was seen.
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;

        // A user can write only their own read state.
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.keys().hasOnly([
            "userId",
            "lastReadAt"
          ])
          && request.resource.data.userId == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // =========================
    // CALLS / WEBRTC SIGNALING
    // =========================

    match /calls/{callId} {
      // Only the two call participants can read a call.
      allow get, list: if request.auth != null
        && (
          request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId
        );

      // The caller creates the ringing call and must belong to
      // the referenced two-person conversation.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "conversationId",
          "callerId",
          "calleeId",
          "type",
          "status",
          "offer",
          "answer",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() > 0
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.type in ["audio", "video"]
        && request.resource.data.status == "ringing"
        && request.resource.data.offer is map
        && request.resource.data.offer.type is string
        && request.resource.data.offer.sdp is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participantIds
        && request.resource.data.calleeId in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participantIds;

      // Participants can update signaling state, answer, and timestamps,
      // but cannot change the identities, conversation, or call type.
      allow update: if request.auth != null
        && (
          request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId
        )
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "answer",
          "updatedAt",
          "endedAt"
        ])
        && request.resource.data.status in [
          "ringing",
          "active",
          "declined",
          "ended",
          "missed"
        ]
        && (
          !request.resource.data.keys().hasAny(["answer"])
          || request.resource.data.answer == null
          || (
            request.resource.data.answer is map
            && request.resource.data.answer.type is string
            && request.resource.data.answer.sdp is string
          )
        )
        && (
          !request.resource.data.keys().hasAny(["endedAt"])
          || request.resource.data.endedAt is timestamp
        );

      // Keep completed call records available for call history.
      // Participants may delete a call if cleanup is ever needed.
      allow delete: if request.auth != null
        && (
          request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId
        );

      // Caller ICE candidates.
      match /offerCandidates/{candidateId} {
        allow read, create, delete: if request.auth != null
          && (
            request.auth.uid == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId
            || request.auth.uid == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId
          );
      }

      // Callee ICE candidates.
      match /answerCandidates/{candidateId} {
        allow read, create, delete: if request.auth != null
          && (
            request.auth.uid == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId
            || request.auth.uid == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId
          );
      }
    }

    // =========================
    // STORIES
    // =========================

    match /stories/{storyId} {
      // Individual Story reads use full privacy check.
      allow get: if canViewStory(resource.data)
        || (
          request.auth != null
          && exists(
            /databases/$(database)/documents/stories/$(storyId)/shares/$(request.auth.uid)
          )
        );

      // Collection queries allow:
      // - your own Stories
      // - public Stories
      // - follower-only Stories when the requester follows the author
      allow list: if request.auth != null
        && (
          resource.data.authorId == request.auth.uid
          || resource.data.visibility == "public"
          || (
            resource.data.visibility == "followers"
            && exists(
              /databases/$(database)/documents/users/$(request.auth.uid)/following/$(resource.data.authorId)
            )
          )
        );

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "authorId",
          "media",
          "mediaType",
          "caption",
          "visibility",
          "createdAt",
          "expiresAt"
        ])
        && request.resource.data.media is list
        && request.resource.data.mediaType in ["image", "video"]
        && request.resource.data.visibility in ["public", "followers"]
        && request.resource.data.expiresAt > request.time;

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      // STORY SHARE ACCESS
      match /shares/{recipientId} {
        allow get: if request.auth != null
          && request.auth.uid == recipientId;

        allow create: if request.auth != null
          && request.resource.data.storyId == storyId
          && request.resource.data.recipientId == recipientId
          && request.resource.data.senderId is string
          && request.resource.data.conversationId is string
          && request.resource.data.messageId is string
          && (
            (
              request.auth.uid == request.resource.data.senderId
              && recipientId != request.auth.uid
              && canViewStory(
                get(
                  /databases/$(database)/documents/stories/$(storyId)
                ).data
              )
            )
            ||
            (
              request.auth.uid == recipientId
              && request.auth.uid in get(
                /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
              ).data.participantIds
              && request.resource.data.senderId in get(
                /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
              ).data.participantIds
              && get(
                /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)/messages/$(request.resource.data.messageId)
              ).data.senderId == request.resource.data.senderId
              && get(
                /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)/messages/$(request.resource.data.messageId)
              ).data.storyId == storyId
              && get(
                /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)/messages/$(request.resource.data.messageId)
              ).data.text == "Shared a story with you."
              && get(
                /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)/messages/$(request.resource.data.messageId)
              ).data.attachmentName == "Story"
            )
          );

        allow update: if request.auth != null
          && request.auth.uid == recipientId
          && request.resource.data.storyId == resource.data.storyId
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.messageId == resource.data.messageId
          && request.resource.data.storyId == storyId
          && request.resource.data.recipientId == recipientId
          && request.resource.data.senderId is string
          && request.resource.data.conversationId is string
          && request.resource.data.messageId is string;

        allow delete: if false;
      }

      // STORY VIEWS
      match /views/{userId} {
        allow read: if request.auth != null
          && (
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data.authorId == request.auth.uid
            || request.auth.uid == userId
          );

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "userId",
            "storyId",
            "createdAt"
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.storyId == storyId
          && canViewStory(
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data
          );

        allow update, delete: if false;
      }

      // STORY REACTIONS
      match /reactions/{userId} {
        allow read: if request.auth != null
          && canViewStory(
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data
          );

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "userId",
            "storyId",
            "reaction",
            "createdAt"
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.storyId == storyId
          && request.resource.data.reaction == "heart"
          && request.resource.data.createdAt == request.time
          && canViewStory(
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data
          );

        allow update: if false;

        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }

    // ========================================================
    // COLLECTION-GROUP INTERACTION READS
    // ========================================================

    match /{path=**}/likes/{likeId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/saves/{saveId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/reposts/{repostId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/shares/{shareId} {
      allow read: if request.auth != null;
    }

}
