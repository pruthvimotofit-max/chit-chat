rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================
    // MESSAGE ATTACHMENTS
    // =========================================
    match /messageAttachments/{conversationId}/{userId}/{fileName} {
      // Only participants in the conversation can read attachments.
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds;

      // Only a conversation participant can upload
      // files under their own user folder.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|video/.*|application/pdf|text/.*|application/msword|application/vnd.openxmlformats-officedocument.*'
        );

      // Attachments are immutable for now.
      allow update: if false;

      // Only the uploader can delete their own attachment.
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }

    // =========================================
    // STORY MEDIA
    // =========================================
    match /media/story/{mediaType}/{userId}/{storyId}/{fileName} {
      // Story media follows the visibility of its Firestore Story.
      // One Story lookup is reused, keeping Storage rule access
      // within Firebase's two-document lookup limit.
      function storyDoc() {
        return firestore.get(
          /databases/(default)/documents/stories/$(storyId)
        ).data;
      }

      function canReadStoryMedia() {
        return request.auth != null
          && storyDoc().authorId == userId
          && (
            storyDoc().authorId == request.auth.uid
            || storyDoc().visibility == "public"
            || (
              storyDoc().visibility == "followers"
              && firestore.exists(
                /databases/(default)/documents/users/$(userId)/followers/$(request.auth.uid)
              )
            )
          );
      }

      allow read: if canReadStoryMedia();

      // Story media is uploaded only by the authenticated owner.
      // The Firestore Story document is created immediately after
      // this upload.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|video/.*'
        );

      // Story media is immutable.
      allow update: if false;

      // Only the Story owner can delete its media.
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // =========================================
    // APP MEDIA
    // =========================================
    match /media/{purpose}/{mediaType}/{userId}/{fileName} {

      // Authenticated users can view media used by the app.
      allow read: if request.auth != null;

      // Only the authenticated owner can upload.
      // Supports images and videos up to 100 MB.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|video/.*|audio/.*'
        );

      // Media is immutable after upload.
      allow update: if false;

      // Only the owner can delete their media.
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // =========================================
    // EVERYTHING ELSE LOCKED
    // =========================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
